# shellcheck disable=SC2034  # Env examples
# Log level: debug, info, warn, error
F2B_LOG_LEVEL=info

# Optional path to a log file for f2b's own logs
# F2B_LOG_FILE=/var/log/f2b.log

# Directories fail2ban uses (must be within an allowed location: logs under
# /var/log; filters under /etc/fail2ban, /usr/local/etc/fail2ban or
# /opt/fail2ban). If set explicitly but invalid, this is a fatal config error
# (no silent fallback to the default); leaving them unset uses the defaults.
F2B_LOG_DIR=/var/log
F2B_FILTER_DIR=/etc/fail2ban/filter.d


# Timeouts in Go duration format (e.g. 30s, 2m). Each is clamped to its maximum.
F2B_COMMAND_TIMEOUT=30s
F2B_FILE_TIMEOUT=10s
F2B_PARALLEL_TIMEOUT=60s

# Testing only (presence-checked: any non-empty value marks a test
# environment and disables real sudo probing — never set in production)
# F2B_TEST=1
# GO_TEST=1
